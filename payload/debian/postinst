#!/bin/sh
# meo-3 postinst: service user, runtime dirs, Node-RED deps, systemd units.
set -e

PREFIX=/opt/meo-3
CONF=/etc/meo-3
DATA=/var/lib/meo-3
SVC_USER=meo

case "$1" in
configure)
    if ! id -u "$SVC_USER" >/dev/null 2>&1; then
        adduser --system --group --home "$DATA" --no-create-home \
                --gecos "MEO 3 gateway" "$SVC_USER"
    fi

    mkdir -p "$DATA/node-red"
    [ -e "$DATA/node-red/flows.json" ] \
        || cp /usr/share/meo-3/flows.json "$DATA/node-red/flows.json"
    chown -R "$SVC_USER":"$SVC_USER" "$DATA"

    # node_modules is generated here, not shipped by dpkg (see postrm). All seven
    # packed packages go in one npm call so the @node-red/* tarballs satisfy
    # node-red's exact-version deps instead of the registry.
    echo "Installing Node-RED dependencies (requires network)..."
    cd "$PREFIX/node-red"
    printf '{\n  "name": "meo-3-node-red",\n  "private": true\n}\n' > package.json
    npm install --omit=dev --no-audit --no-fund ./modules/*.tgz

    if [ -d /etc/mosquitto/conf.d ]; then
        deb-systemd-invoke restart mosquitto.service || true
    fi

    systemctl daemon-reload || true
    deb-systemd-helper enable meo-ble.service meo-service.service meo-node-red.service || true
    deb-systemd-invoke start meo-ble.service meo-service.service meo-node-red.service || true

    echo ""
    echo "MEO 3 installed."
    echo "  Node-RED editor : http://$(hostname -I 2>/dev/null | awk '{print $1}'):1880"
    echo "  service API     : http://localhost:7070"
    echo "  status          : meo-3 status"
    ;;
abort-upgrade|abort-remove|abort-deconfigure) ;;
esac

exit 0
