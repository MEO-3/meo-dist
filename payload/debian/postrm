#!/bin/sh
# meo-3 postrm: clean up what dpkg does not own.
set -e

PREFIX=/opt/meo-3
DATA=/var/lib/meo-3

case "$1" in
remove)
    # Generated by postinst's npm install, so dpkg will not remove it.
    rm -rf "$PREFIX/node-red/node_modules" "$PREFIX/node-red/package.json" \
           "$PREFIX/node-red/package-lock.json"
    rmdir --ignore-fail-on-non-empty "$PREFIX/node-red" "$PREFIX" 2>/dev/null || true
    if command -v deb-systemd-helper >/dev/null 2>&1; then
        deb-systemd-helper mask meo-ble.service meo-service.service meo-node-red.service >/dev/null || true
    fi
    systemctl daemon-reload || true
    ;;
purge)
    rm -rf "$PREFIX" "$DATA" /etc/meo-3
    if command -v deb-systemd-helper >/dev/null 2>&1; then
        deb-systemd-helper purge meo-ble.service meo-service.service meo-node-red.service >/dev/null || true
        deb-systemd-helper unmask meo-ble.service meo-service.service meo-node-red.service >/dev/null || true
    fi
    systemctl daemon-reload || true
    # Leaves the meo user in place: purging a user that may still own files
    # elsewhere is riskier than an idle system account.
    ;;
upgrade|failed-upgrade|abort-install|abort-upgrade|disappear) ;;
esac

exit 0
