# MEO 3 gateway runtime config. Read by the Java service (and by bin/meo-3 when
# running without systemd).

MEO_SERVICE_HOST=127.0.0.1
MEO_SERVICE_PORT=7070
MEO_API_URL=http://127.0.0.1:7070

# SQLite database and other service state live here.
MEO_DATA_DIR=/var/lib/meo-3

# Broker used to reach the Rust BLE service (blemqtt). The BLE service itself
# hardcodes localhost:1883, so the broker must run on this machine.
MEO_MQTT_BROKER=tcp://localhost:1883
